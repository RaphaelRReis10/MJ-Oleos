# URL pública do site (usada em canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.mjoleos.com.br

# Google Analytics 4 — deixe vazio enquanto não houver a propriedade criada.
# O site funciona normalmente sem esta variável; o tracking apenas não carrega.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager — alternativa ao GA4 direto (PRD §66).
# Se preenchido, o GTM é carregado no lugar do gtag.js.
NEXT_PUBLIC_GTM_ID=
